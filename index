<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Vamos PR</title>
<style>
  :root{
    --bg:#fbf6ec; --card:#ffffff; --ink:#1f2a37; --muted:#6b7280; --line:#e8dfcc;
    --teal:#0e7c86; --coral:#e4572e; --sun:#f2b134; --leaf:#2f855a;
    --radius:14px;
  }
  @media (prefers-color-scheme: dark){
    :root{ --bg:#14181d; --card:#1d232b; --ink:#eef1f5; --muted:#9aa4b2; --line:#2c343e; --teal:#35b6c1; }
  }
  *{box-sizing:border-box}
  body{margin:0;font:16px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--ink)}
  header{background:linear-gradient(135deg,var(--teal),#0a5a62);color:#fff;padding:18px 16px 0}
  header h1{margin:0;font-size:1.4rem}
  header .sub{opacity:.85;font-size:.9rem;margin-top:2px}
  .who{float:right;font-size:.8rem;opacity:.9;text-align:right}
  .who button{background:none;border:0;color:#fff;text-decoration:underline;cursor:pointer;padding:0;font:inherit}
  nav{display:flex;gap:4px;overflow-x:auto;margin-top:14px;padding-bottom:0}
  nav button{flex:0 0 auto;border:0;background:transparent;color:#d7f0f2;padding:10px 14px;border-radius:10px 10px 0 0;cursor:pointer;font:inherit;font-weight:600}
  nav button.on{background:var(--bg);color:var(--ink)}
  main{max-width:820px;margin:0 auto;padding:16px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:14px;margin-bottom:12px}
  .row{display:flex;gap:8px;flex-wrap:wrap}
  input,textarea,select{width:100%;padding:10px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);font:inherit}
  textarea{min-height:70px;resize:vertical}
  label{display:block;font-size:.78rem;color:var(--muted);margin:8px 0 3px}
  .btn{background:var(--coral);color:#fff;border:0;padding:10px 16px;border-radius:10px;font:inherit;font-weight:600;cursor:pointer}
  .btn.ghost{background:transparent;color:var(--teal);border:1px solid var(--line)}
  .btn.small{padding:5px 10px;font-size:.8rem}
  .item h3{margin:0 0 4px;font-size:1.05rem}
  .meta{color:var(--muted);font-size:.85rem;display:flex;gap:10px;flex-wrap:wrap;margin:4px 0}
  .tag{display:inline-block;padding:2px 9px;border-radius:99px;font-size:.72rem;font-weight:700;background:var(--sun);color:#3b2a00}
  .tag.Booked,.tag.Confirmed,.tag.Done{background:var(--leaf);color:#fff}
  .tag.Idea{background:var(--line);color:var(--ink)}
  .actions{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap}
  .empty{color:var(--muted);text-align:center;padding:30px 10px}
  .chat{display:flex;flex-direction:column;height:calc(100vh - 230px);min-height:340px}
  .msgs{flex:1;overflow-y:auto;padding:6px}
  .msg{max-width:80%;margin:6px 0;padding:8px 12px;border-radius:14px;background:var(--card);border:1px solid var(--line);word-wrap:break-word}
  .msg.me{margin-left:auto;background:var(--teal);color:#fff;border-color:var(--teal)}
  .msg .n{font-size:.7rem;opacity:.75;font-weight:700}
  .chatbar{display:flex;gap:8px;margin-top:8px}
  .overlay{max-width:460px;margin:8vh auto;padding:0 16px}
  .err{color:var(--coral);font-size:.9rem}
  a{color:var(--teal)}
  code{background:var(--line);padding:1px 6px;border-radius:6px;font-size:.85em}
  .hide{display:none}
</style>
</head>
<body>
<div id="app"></div>

<script type="module">
/* ------------------------------------------------------------------
   1) PASTE YOUR FIREBASE WEB APP CONFIG HERE
      (Firebase console > Project settings > Your apps > Web app > Config)
------------------------------------------------------------------- */
const firebaseConfig = {
  apiKey: "AIzaSyATboR8tMjADmP0wa19g0Njs8PtJyUqRXo",
  authDomain: "vamospr-badf7.firebaseapp.com",
  projectId: "vamospr-badf7",
  storageBucket: "vamospr-badf7.firebasestorage.app",
  messagingSenderId: "876412272501",
  appId: "1:876412272501:web:186e132c79024ee9de9d3c"
};

import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getFirestore, collection, doc, addDoc, setDoc, updateDoc, deleteDoc, onSnapshot,
         query, orderBy, serverTimestamp, arrayUnion, arrayRemove } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

const $app = document.getElementById("app");
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const ls = { get:k=>{try{return localStorage.getItem(k)}catch{return null}}, set:(k,v)=>{try{localStorage.setItem(k,v)}catch{}}, del:k=>{try{localStorage.removeItem(k)}catch{}} };

const CATS = {
  lodging:  { label:"Lodging",        icon:"🏡", titlePh:"e.g. Airbnb in Old San Juan", dateLabel:"Dates",  statuses:["Idea","Considering","Booked"] },
  transport:{ label:"Transport",      icon:"🚗", titlePh:"e.g. Rental car from SJU",     dateLabel:"Date",   statuses:["Idea","Considering","Booked"] },
  flights:  { label:"Flights",        icon:"✈️", titlePh:"e.g. CLE → SJU, Feb 9",        dateLabel:"Date",   statuses:["Idea","Considering","Booked"] },
  activities:{label:"Activities",     icon:"🎉", titlePh:"e.g. Kayak bioluminescent bay", dateLabel:"Date",  statuses:["Idea","Planned","Done"] },
  places:   { label:"Places",         icon:"📍", titlePh:"e.g. El Yunque",                dateLabel:"When",  statuses:["Idea","Planned","Done"] },
  food:     { label:"Restaurants",    icon:"🍽️", titlePh:"e.g. Lechonera in Guavate",     dateLabel:"When",  statuses:["Idea","Planned","Done"] },
};
const TABS = ["chat","overview",...Object.keys(CATS)];
const TAB_LABEL = { chat:"💬 Chat", overview:"🗺️ Overview", ...Object.fromEntries(Object.entries(CATS).map(([k,v])=>[k,v.icon+" "+v.label])) };

let db, tripCode = ls.get("pr_trip"), me = ls.get("pr_name"), tab = ls.get("pr_tab") || "chat";
let unsubs = [];
let data = {}; // cat -> array
let messages = [];
let overview = { text:"" };
let editing = null; // {cat,id}

const configured = !Object.values(firebaseConfig).some(v => String(v).includes("PASTE_ME"));

function boot(){
  if(!configured){ return renderSetupNeeded(); }
  db = getFirestore(initializeApp(firebaseConfig));
  if(!tripCode || !me){ return renderJoin(); }
  startListening();
  renderShell();
}

function renderSetupNeeded(){
  $app.innerHTML = `<div class="overlay"><div class="card">
    <h2>Almost there 🌴</h2>
    <p>This app needs your Firebase config. Open <code>index.html</code> and paste your web app config into the <code>firebaseConfig</code> block near the top of the script. The README walks through it in about five minutes.</p>
  </div></div>`;
}

function renderJoin(err=""){
  $app.innerHTML = `<div class="overlay"><div class="card">
    <h2>¡Vamos a Puerto Rico! 🇵🇷</h2>
    <p style="color:var(--muted)">Enter your name and the trip code your group shares. Anyone with the same code sees the same trip.</p>
    <label>Your name</label><input id="jn" value="${esc(me||"")}" maxlength="30" placeholder="e.g. Damian">
    <label>Trip code</label><input id="jc" value="${esc(tripCode||"")}" maxlength="40" placeholder="pick something long, e.g. pr-feb-2027-x7k2q9">
    <p class="err" id="je">${esc(err)}</p>
    <button class="btn" id="jb">Join trip</button>
  </div></div>`;
  document.getElementById("jb").onclick = () => {
    const n = document.getElementById("jn").value.trim();
    const c = document.getElementById("jc").value.trim().toLowerCase().replace(/[^a-z0-9_-]/g,"");
    if(!n) return renderJoin("Please enter your name.");
    if(c.length < 8) return renderJoin("Trip code needs at least 8 letters/numbers (a-z, 0-9, - or _) so it can't be guessed.");
    me = n; tripCode = c; ls.set("pr_name", n); ls.set("pr_trip", c);
    boot();
  };
}

function tripRef(...p){ return [db, "trips", tripCode, ...p]; }

function startListening(){
  unsubs.forEach(u=>u()); unsubs = [];
  data = {};
  for(const cat of Object.keys(CATS)){
    unsubs.push(onSnapshot(query(collection(...tripRef(cat)), orderBy("createdAt","asc")), snap => {
      data[cat] = snap.docs.map(d => ({id:d.id, ...d.data()}));
      if(tab===cat && !editing) renderBody();
    }, e => showErr(e)));
  }
  unsubs.push(onSnapshot(query(collection(...tripRef("messages")), orderBy("createdAt","asc")), snap => {
    messages = snap.docs.map(d => ({id:d.id, ...d.data()}));
    if(tab==="chat") renderChatMsgs(true);
  }, e => showErr(e)));
  unsubs.push(onSnapshot(doc(...tripRef("meta","overview")), s => {
    overview = s.exists() ? s.data() : { text:"" };
    if(tab==="overview" && !document.getElementById("ovText")?.matches(":focus")) renderBody();
  }, e => showErr(e)));
}

function showErr(e){
  console.error(e);
  const el = document.getElementById("body");
  if(el) el.insertAdjacentHTML("afterbegin", `<div class="card err">Connection problem: ${esc(e.code||e.message)}. Check your Firestore rules and config.</div>`);
}

function renderShell(){
  $app.innerHTML = `
  <header>
    <div class="who">${esc(me)}<br><button id="leave">switch</button></div>
    <h1>Vamos PR 🌴</h1>
    <div class="sub">Puerto Rico trip planner · Feb 2027</div>
    <nav id="nav">${TABS.map(t=>`<button data-t="${t}" class="${t===tab?"on":""}">${TAB_LABEL[t]}</button>`).join("")}</nav>
  </header>
  <main id="body"></main>`;
  document.getElementById("leave").onclick = () => { ls.del("pr_name"); ls.del("pr_trip"); me=null; tripCode=null; unsubs.forEach(u=>u()); renderJoin(); };
  document.querySelectorAll("#nav button").forEach(b => b.onclick = () => { tab=b.dataset.t; ls.set("pr_tab",tab); editing=null;
    document.querySelectorAll("#nav button").forEach(x=>x.classList.toggle("on",x===b)); renderBody(); });
  renderBody();
}

function renderBody(){
  const body = document.getElementById("body"); if(!body) return;
  if(tab==="chat") return renderChat(body);
  if(tab==="overview") return renderOverview(body);
  renderCategory(body, tab);
}

/* ---------------- Chat ---------------- */
function renderChat(body){
  body.innerHTML = `<div class="chat"><div class="msgs" id="msgs"></div>
    <form class="chatbar" id="cf"><input id="ci" placeholder="Message the group…" autocomplete="off" maxlength="1000"><button class="btn">Send</button></form></div>`;
  renderChatMsgs(true);
  document.getElementById("cf").onsubmit = async e => {
    e.preventDefault();
    const i = document.getElementById("ci"), t = i.value.trim(); if(!t) return;
    i.value = "";
    try { await addDoc(collection(...tripRef("messages")), { text:t, name:me, createdAt:serverTimestamp() }); } catch(err){ showErr(err); }
  };
}
function renderChatMsgs(scroll){
  const box = document.getElementById("msgs"); if(!box) return;
  const atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 80;
  box.innerHTML = messages.length ? messages.map(m => `<div class="msg ${m.name===me?"me":""}"><div class="n">${esc(m.name)}${fmtTime(m.createdAt)}</div>${esc(m.text)}</div>`).join("")
    : `<div class="empty">No messages yet. Say hola! 👋</div>`;
  if(scroll && atBottom || scroll && messages.length<2) box.scrollTop = box.scrollHeight;
}
function fmtTime(ts){ if(!ts?.toDate) return ""; const d=ts.toDate(); return " · "+d.toLocaleDateString([], {month:"short",day:"numeric"})+" "+d.toLocaleTimeString([], {hour:"numeric",minute:"2-digit"}); }

/* ---------------- Overview ---------------- */
const DEFAULT_OVERVIEW = `Who's going & when
• Catherine, Damian: Feb 9 – Feb 19
• Sara, Thomas, Amy, Jenna, Dave: Feb 12 – Feb 19

Notes, reminders, group links…`;
function renderOverview(body){
  const counts = Object.entries(CATS).map(([k,v])=>`<div class="card" style="flex:1 1 130px;text-align:center;cursor:pointer" data-go="${k}"><div style="font-size:1.6rem">${v.icon}</div><b>${(data[k]||[]).length}</b><div class="meta" style="justify-content:center">${v.label}</div></div>`).join("");
  body.innerHTML = `<div class="row">${counts}</div>
    <div class="card"><b>Trip notes</b> <span class="meta">shared — edits save when you click away</span>
    <textarea id="ovText" style="min-height:220px">${esc(overview.text || DEFAULT_OVERVIEW)}</textarea></div>`;
  body.querySelectorAll("[data-go]").forEach(c => c.onclick = () => document.querySelector(`#nav [data-t="${c.dataset.go}"]`).click());
  document.getElementById("ovText").onblur = async e => {
    try { await setDoc(doc(...tripRef("meta","overview")), { text:e.target.value, updatedBy:me, updatedAt:serverTimestamp() }); } catch(err){ showErr(err); }
  };
}

/* ---------------- Categories ---------------- */
function renderCategory(body, cat){
  const C = CATS[cat], items = data[cat] || [];
  body.innerHTML = `<div class="card"><button class="btn" id="addb">+ Add to ${C.label}</button></div><div id="form"></div>
    <div id="list">${items.length ? items.map(i => itemCard(cat,i)).join("") : `<div class="empty">Nothing here yet. Add the first ${C.label.toLowerCase()} idea!</div>`}</div>`;
  document.getElementById("addb").onclick = () => openForm(cat);
  body.querySelectorAll("[data-act]").forEach(b => b.onclick = () => itemAction(cat, b.dataset.id, b.dataset.act));
}

function itemCard(cat,i){
  const votes = i.votes || [], voted = votes.includes(me);
  const link = i.link ? `<a href="${esc(/^https?:\/\//.test(i.link)?i.link:"https://"+i.link)}" target="_blank" rel="noopener">link ↗</a>` : "";
  return `<div class="card item">
    <h3>${esc(i.title)} <span class="tag ${esc(i.status)}">${esc(i.status||"Idea")}</span></h3>
    <div class="meta">${i.date?`<span>📅 ${esc(i.date)}</span>`:""}${i.cost?`<span>💵 ${esc(i.cost)}</span>`:""}${i.who?`<span>👥 ${esc(i.who)}</span>`:""}${link}</div>
    ${i.notes?`<div style="white-space:pre-wrap">${esc(i.notes)}</div>`:""}
    <div class="meta">added by ${esc(i.addedBy||"?")}</div>
    <div class="actions">
      <button class="btn ghost small" data-act="vote" data-id="${i.id}">${voted?"👍 Voted":"👍 Vote"} ${votes.length||""}</button>
      <button class="btn ghost small" data-act="edit" data-id="${i.id}">Edit</button>
      <button class="btn ghost small" data-act="del" data-id="${i.id}">Delete</button>
    </div></div>`;
}

async function itemAction(cat,id,act){
  const item = (data[cat]||[]).find(x=>x.id===id); if(!item) return;
  try{
    if(act==="vote") await updateDoc(doc(...tripRef(cat,id)), { votes: (item.votes||[]).includes(me) ? arrayRemove(me) : arrayUnion(me) });
    if(act==="del" && confirm(`Delete "${item.title}"?`)) await deleteDoc(doc(...tripRef(cat,id)));
    if(act==="edit") openForm(cat, item);
  }catch(e){ showErr(e); }
}

function openForm(cat, item=null){
  const C = CATS[cat]; editing = {cat, id:item?.id};
  const f = document.getElementById("form");
  f.innerHTML = `<div class="card"><b>${item?"Edit":"New"} ${C.label}</b>
    <label>Title</label><input id="f_title" placeholder="${esc(C.titlePh)}" value="${esc(item?.title||"")}">
    <div class="row"><div style="flex:1 1 180px"><label>${C.dateLabel}</label><input id="f_date" value="${esc(item?.date||"")}" placeholder="Feb 12–19"></div>
      <div style="flex:1 1 140px"><label>Cost</label><input id="f_cost" value="${esc(item?.cost||"")}" placeholder="$120/night"></div>
      <div style="flex:1 1 140px"><label>Status</label><select id="f_status">${C.statuses.map(s=>`<option ${((item?.status)||C.statuses[0])===s?"selected":""}>${s}</option>`).join("")}</select></div></div>
    <label>Link</label><input id="f_link" value="${esc(item?.link||"")}" placeholder="https://…">
    <label>Who's in?</label><input id="f_who" value="${esc(item?.who||"")}" placeholder="everyone, or names">
    <label>Notes</label><textarea id="f_notes">${esc(item?.notes||"")}</textarea>
    <div class="actions"><button class="btn" id="f_save">Save</button><button class="btn ghost" id="f_cancel">Cancel</button></div></div>`;
  f.scrollIntoView({behavior:"smooth"});
  document.getElementById("f_cancel").onclick = () => { editing=null; f.innerHTML=""; };
  document.getElementById("f_save").onclick = async () => {
    const v = id => document.getElementById(id).value.trim();
    if(!v("f_title")) return alert("Add a title first.");
    const payload = { title:v("f_title"), date:v("f_date"), cost:v("f_cost"), status:v("f_status"), link:v("f_link"), who:v("f_who"), notes:v("f_notes"), updatedBy:me, updatedAt:serverTimestamp() };
    try{
      if(item) await updateDoc(doc(...tripRef(cat,item.id)), payload);
      else await addDoc(collection(...tripRef(cat)), { ...payload, addedBy:me, votes:[], createdAt:serverTimestamp() });
      editing=null; f.innerHTML="";
    }catch(e){ showErr(e); }
  };
}

boot();
</script>
</body>
</html>
